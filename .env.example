# =============================================================================
# MemeMasters – variables d'environnement
# Copier ce fichier en .env.local (jamais commité) et remplir les valeurs.
# En production (Vercel), les saisir dans Settings → Environment Variables.
# =============================================================================

# --- Site -------------------------------------------------------------------
# URL publique du site, sans « / » final. Sert aux liens des e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase : clés publiques (exposées au navigateur, c'est normal) -------
# Tableau de bord Supabase → Project Settings → API.
# En local, `npx supabase start` affiche ces valeurs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase : secrets (serveur uniquement, ne JAMAIS préfixer NEXT_PUBLIC_) -
# Connexion Postgres du serveur pour les transactions de jeu.
# Production : Project Settings → Database → Connection string → « Transaction pooler » (port 6543).
# Local : postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Clé secrète (ex-« service_role »). Utilisée à partir de la phase 2 (Storage, rôles admin).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Connexion Google (lue par supabase/config.toml en local) ---------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Développement ----------------------------------------------------------
# Mettre 1 pour activer le service worker en `npm run dev` (désactivé par défaut).
NEXT_PUBLIC_ENABLE_SW_DEV=0

# --- Phases suivantes (laisser vide pour l'instant) -------------------------
# Phase 4 : secret partagé entre pg_cron/pg_net et les routes /api/cron/*.
CRON_SECRET=
# Phase 5 : Stripe en mode test (Dashboard → Developers → API keys / Webhooks).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Anti-robot : Cloudflare Turnstile (connexion, inscription, mot de passe oublié, contact)
# Créez un site (gratuit) sur dash.cloudflare.com → Turnstile, puis copiez les deux clés.
# Laissées vides : en local, clés de test de Cloudflare (captcha visible, toujours validé) ;
# en production, captcha désactivé (avertissement dans les journaux).
# Clés de test Cloudflare (toujours validées) : site 1x00000000000000000000AA,
# secrète 1x0000000000000000000000000000000AA.
# Ne PAS activer en plus la protection CAPTCHA de Supabase (un jeton ne sert qu'une fois).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
